# Leave these empty to use the local Vite proxy in development.
VITE_BE_URL=
VITE_API_URL=

# Firebase Web API configuration used for Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_EXCHANGE_URL=https://identitytoolkit.googleapis.com/v1/accounts:signInWithIdp
VITE_GOOGLE_CLIENT_ID=

# Legacy core-governance configuration. The current src tree does not use Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
